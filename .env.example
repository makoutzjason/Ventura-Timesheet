# Supabase — Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: full access, bypasses RLS. Server-side only — never
# expose this to the browser (it is NOT prefixed with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com/api-keys
RESEND_API_KEY=
# The "from" address for outgoing mail, e.g. "Ventura Timesheets <timesheets@yourdomain.com>".
# Must be on a domain you've verified in Resend.
EMAIL_FROM=

# Base URL this app is served from, used to build links in emails
# (approval links, reminder links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# calls /api/cron/reminders. Generate any random string for this.
CRON_SECRET=
